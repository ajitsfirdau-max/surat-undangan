        /* ==========================================================================
           PENGATURAN KUSTOMISASI SIMPEL (EDIT DI SINI)
           ========================================================================== */
        :root {
            /* 1. KUSTOMISASI BACKGROUND GAMBAR */
            --bg-cover-utama: url('https://cdn.phototourl.com/free/2026-08-20-0b5fb753-91c6-42e5-a048-7e65eab5b8d8.jpg');
            --bg-cover-kedua: url('https://cdn.phototourl.com/free/2026-08-20-6aa21615-29b9-4daf-b312-763378784041.jpg');
            
            /* 2. WARNA UTAMA */
            --warna-tema: #d4af37; /* Warna Emas */
            --warna-teks: #333333;
            --warna-teks-muda: #fff;
        }

        /* ==========================================================================
           STYLE DASAR & FONT (JANGAN DIUBAH AGAR TETAP SESUAI TEMA)
           ========================================================================== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            color: var(--warna-teks);
            background-color: #f9f6f0;
            overflow-x: hidden;
        }

        /* Font Khusus Judul & Nama Pengantin */
        h1, h2, h3, .font-judul, .navbar-brand {
            font-family: 'Great Vibes', cursive !important;
            font-weight: normal;
        }

        /* ==========================================================================
           FITUR TRANSISI SMOOTH (FADE-IN UP)
           ========================================================================== */
        .fade-in-element {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 1s ease-out, transform 1s ease-out;
        }

        .fade-in-element.appear {
            opacity: 1;
            transform: translateY(0);
        }

        /* ==========================================================================
           EFEK BACKGROUND KACA (GLASSMORPHISM)
           ========================================================================== */
        .glass-panel {
            background: transparent;
            backdrop-filter: none;
            -webkit-backdrop-filter: none;
            border: none;
            border-radius: 20px;
            padding: 30px;
            box-shadow: none;
            color: #fff;
            text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.6);
            margin: 20px auto;
            max-width: 600px;
            width: 90%;
        }

        .glass-panel h3, .glass-panel h2 {
            color: #fff;
        }

        /* ==========================================================================
           HALAMAN COVER UTAMA
           ========================================================================== */
        #cover-utama {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100vh;
            background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), var(--bg-cover-utama);
            background-size: cover;
            background-position: center;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            z-index: 1000;
            transition: transform 1s ease-in-out;
            padding: 20px;
            color: #fff;
        }

        #cover-utama h1 {
            font-size: 3.5rem;
            margin-bottom: 10px;
            color: var(--warna-tema);
        }

        .btn-buka {
            padding: 12px 30px;
            font-family: 'Montserrat', sans-serif;
            font-size: 0.9rem;
            font-weight: 600;
            background-color: var(--warna-tema);
            color: #white;
            border: none;
            border-radius: 30px;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            transition: all 0.3s;
            margin-top: 20px;
        }

        .btn-buka:hover {
            transform: scale(1.05);
            background-color: #fff;
            color: #333;
        }

        /* ==========================================================================
           KONTEN UTAMA (SLIDE KEDUA DAN SETERUSNYA)
           ========================================================================== */
        #konten-undangan {
            display: none;
            background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), var(--bg-cover-kedua);
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            min-height: 100vh;
            padding: 60px 10px;
            text-align: center;
        }

        section {
            padding: 40px 0;
        }

        /* FITUR AVATAR KOTAK MELENGKUNG (CUSTOMIZABLE) */
        .avatar-frame {
            width: 300px;
            height: 300px;
            border-radius: 30px; /* Melengkung Kotak */
            border: 3px solid rgba(255,255,255,0.7);
            object-fit: cover;
            margin: 15px auto;
            box-shadow: 0 8px 16px rgba(0,0,0,0.2);
        }

        .nama-besar {
            font-size: 2.8rem !important;
            color: var(--warna-tema) !important;
            margin: 10px 0;
        }

        /* ==========================================================================
           FITUR COUNTDOWN
           ========================================================================== */
        .countdown-container {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 20px;
        }

        .countdown-box {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            padding: 10px;
            min-width: 70px;
            backdrop-filter: blur(5px);
            border: 1px solid rgba(255,255,255,0.2);
        }

        .countdown-box span {
            display: block;
            font-size: 1.5rem;
            font-weight: 700;
        }

        .countdown-box label {
            font-size: 0.75rem;
            text-transform: uppercase;
        }

        /* ==========================================================================
           FITUR GALERI (15 FOTO RESPONSIF)
           ========================================================================== */
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(140px, 1fr));
            gap: 12px;
            margin-top: 20px;
        }

        @media(min-width: 768px) {
            .gallery-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        .gallery-item {
            width: 100%;
            height: 200px;
            object-fit: cover;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
            transition: transform 0.3s;
            cursor: pointer;
        }

        .gallery-item:hover {
            transform: scale(1.05);
        }

        /* ==========================================================================
           INPUT & FORM RSVP
           ========================================================================== */
        .form-group {
            text-align: left;
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-size: 0.85rem;
            font-weight: 500;
        }

        .form-control {
            width: 100%;
            padding: 10px;
            border-radius: 8px;
            border: 1px solid rgba(255,255,255,0.4);
            background: rgba(255,255,255,0.9);
            color: #333;
            font-family: 'Montserrat', sans-serif;
        }

        .radio-group {
            display: flex;
            gap: 15px;
            margin-top: 5px;
        }

        .btn-submit {
            width: 100%;
            padding: 12px;
            background-color: var(--warna-tema);
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.3s;
            margin-top: 10px;
        }

        .btn-submit:hover {
            background-color: #bfa030;
        }

        /* ==========================================================================
           MUSIK AUDIO KONTROL MELAYANG
           ========================================================================== */
        #music-control {
            position: fixed;
            bottom: 20px;
            right: 20px;
            width: 50px;
            height: 50px;
            background: var(--warna-tema);
            color: white;
            border-radius: 50%;
            display: none;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            z-index: 2000;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
