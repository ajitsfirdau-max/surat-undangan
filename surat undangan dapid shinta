    <!-- ==========================================================================
       JAVASCRIPT LOGIC (SIMPEL & FUNGSIONAL)
       ========================================================================== */ -->
    <script>
        // 1. OTOMATIS AMBIL NAMA TAMU DARI URL DENGAN PARAMETER (?to=Nama+Tamu)
        window.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const namaTamu = urlParams.get('to');
            if (namaTamu) {
                document.getElementById('nama-tamu').innerText = namaTamu;
                document.getElementById('rsvp-nama').value = namaTamu;
            }
        });

        // 2. FUNGSI TOMBOL BUKA UNDANGAN
        function bukaUndangan() {
            const cover = document.getElementById('cover-utama');
            const konten = document.getElementById('konten-undangan');
            const musicControl = document.getElementById('music-control');
            const music = document.getElementById('wedding-music');

            cover.style.transform = 'translateY(-100vh)';
            konten.style.display = 'block';
            musicControl.style.display = 'flex';
            
            // Putar audio otomatis setelah klik buka
            music.play().catch(error => console.log("Autoplay diblokir browser, memerlukan interaksi pengguna."));
            
            setTimeout(() => {
                cover.style.display = 'none';
                initScrollTransition(); // Jalankan efek smooth text pasca buka
            }, 1000);
        }

        // 3. AUDIO PLAYER KONTROL (PLAY / PAUSE)
        function toggleMusic() {
            const music = document.getElementById('wedding-music');
            const icon = document.getElementById('music-icon');
            if (music.paused) {
                music.play();
                icon.className = "fas fa-music";
            } else {
                music.pause();
                icon.className = "fas fa-pause";
            }
        }

        // 4. HITUNG MUNDUR (COUNTDOWN) AKAD NIKAH: 27 SEPTEMBER 2026
        const targetDate = new Date("September 27, 2026 08:00:00").getTime();
        
        setInterval(() => {
            const now = new Date().getTime();
            const distance = targetDate - now;

            if (distance < 0) {
                document.getElementById("days").innerText = "00";
                document.getElementById("hours").innerText = "00";
                document.getElementById("minutes").innerText = "00";
                document.getElementById("seconds").innerText = "00";
                return;
            }

            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);

            document.getElementById("days").innerText = days < 10 ? "0" + days : days;
            document.getElementById("hours").innerText = hours < 10 ? "0" + hours : hours;
            document.getElementById("minutes").innerText = minutes < 10 ? "0" + minutes : minutes;
            document.getElementById("seconds").innerText = seconds < 10 ? "0" + seconds : seconds;
        }, 1000);

        // 5. FITUR TRANSISI SMOOTH (INTERSECTION OBSERVER)
        function initScrollTransition() {
            const elements = document.querySelectorAll('.fade-in-element');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('appear');
                    }
                });
            }, { threshold: 0.1 });

            elements.forEach(element => {
                observer.observe(element);
            });
        }

        // 6. FITUR RSVP INTEGRASI WHATSAPP OTOMATIS (CUSTOMIZABLE NO HP)
        function kirimRSVPAutomated(event) {
            event.preventDefault();
            
            // CUSTOM NOMOR WHATSAPP DI SINI (Gunakan kode negara, misal: 628xxx)
            const noWA_Pria = "6285156952310"; 
            const noWA_Wanita = "628987654321";

            const nama = document.getElementById('rsvp-nama').value;
            const jumlah = document.getElementById('rsvp-jumlah').value;
            const status = document.querySelector('input[name="status"]:checked').value;
            const tujuan = document.querySelector('input[name="tujuan-wa"]:checked').value;
            const ucapan = document.getElementById('rsvp-ucapan').value;

            const nomorTujuan = (tujuan === "pria") ? noWA_Pria : noWA_Wanita;

            const teksPesan = `Halo, saya ingin konfirmasi kehadiran untuk Undangan Pernikahan Dapid & Shinta.\n\n` +
                             `*Nama:* ${nama}\n` +
                             `*Jumlah:* ${jumlah}\n` +
                             `*Status:* ${status}\n` +
                             `*Ucapan/Doa:* ${ucapan}`;

            const urlWhatsApp = `https://api.whatsapp.com/send?phone=${nomorTujuan}&text=${encodeURIComponent(teksPesan)}`;
            window.open(urlWhatsApp, '_blank');
        }

        // 7. FUNGSI SALIN REKENING
        function salinTeks(elementId) {
            const text = document.getElementById(elementId).innerText;
            navigator.clipboard.writeText(text).then(() => {
                alert("Nomor rekening berhasil disalin!");
            });
        }
    </script>
